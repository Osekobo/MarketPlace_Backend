# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
PROJECT_NAME="Hyper-Local Logistics & Marketplace API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Async URL is used by the FastAPI application (asyncpg driver).
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=marketplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# If you prefer to set a full URL directly, override DATABASE_URL below.
# The application reads DATABASE_URL (asyncpg). Alembic derives the sync URL
# (psycopg2) automatically from it, or you can override SYNC_DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5432/marketplace
SYNC_DATABASE_URL=postgresql+psycopg2://marketplace:marketplace@localhost:5432/marketplace

# ---------------------------------------------------------------------------
# Redis (cache + pub/sub broker)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-super-secret-key-please-generate-a-real-one
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
